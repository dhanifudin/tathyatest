{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["cypress", "@cypress/grep", "node"]
  },
  "include": ["src/adapters/cypress/templates/**/*.ts", "test/fixtures/golden-cypress/**/*.ts"]
}
