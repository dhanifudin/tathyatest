{
  "name": "tathyatest-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tt": "./bin/tt"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "commander": "^12.1.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
