{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["cypress", "@cypress/grep", "node"]
  },
  "include": ["cypress.config.ts", "tests/**/*.cy.ts"],
  "exclude": ["tests/baseline-public"]
}
